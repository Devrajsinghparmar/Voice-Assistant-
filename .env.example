# ==========================================
# Personal Voice Assistant Environment Configuration
# ==========================================

# Groq API Key (Recommended for ultra-fast, free inference & Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Alternative option)
OPENAI_API_KEY=

# API Provider Selection: 'groq' or 'openai' (auto-detected if blank)
API_PROVIDER=groq

# LLM Model Selection:
# Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# OpenAI models: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
LLM_MODEL=llama-3.3-70b-versatile

# Speech-to-Text Model:
# Groq: whisper-large-v3-turbo, whisper-large-v3
# OpenAI: whisper-1
STT_MODEL=whisper-large-v3-turbo

# Audio Recording Settings
AUDIO_DURATION=5
SAMPLE_RATE=44100
AUDIO_CHANNELS=1
TEMP_AUDIO_FILE=input_audio.wav

# Text-to-Speech Settings
# Engine options: pyttsx3 (offline), openai (cloud)
TTS_ENGINE=pyttsx3
VOICE_RATE=175
VOICE_VOLUME=1.0
TTS_VOICE_GENDER=female
